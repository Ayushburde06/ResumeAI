# ⚠️  ROTATE ALL KEYS BELOW — previous values were exposed. Get new ones from each provider.
#     This file is git-ignored. Never commit real credentials.

# ── App Security ─────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=CHANGE_THIS_TO_A_RANDOM_64_CHAR_HEX_STRING

# ── Environment (set to "production" on your hosting platform) ───────────────
# Setting ENV=production disables /docs, /redoc, /openapi.json endpoints.
ENV=development

# ── Admin Access (comma-separated email addresses with unlimited quota) ───────
# REQUIRED for admin features. Keep this secret — do not share publicly.
ADMIN_EMAILS=your-admin-email@example.com

# ── CORS (comma-separated origins allowed to call the API) ───────────────────
# Dev:  http://localhost:5173
# Prod: https://your-frontend.vercel.app,https://your-custom-domain.com
ALLOWED_ORIGINS=http://localhost:5173

# ── Model Configuration ──────────────────────────────────────────────────────
# Available models: glm, kimi, qwen, minimax
# GLM-5 is recommended (fastest + best quality).
DEFAULT_MODEL_ID=glm

# ── GLM-5 (Recommended) ──────────────────────────────────────────────────────
GLM_API_KEY=YOUR_GLM_API_KEY_HERE
GLM_ENDPOINT=https://bedrock-mantle.us-east-1.api.aws/v1
GLM_MODEL=zai.glm-5

# ── Kimi 2.5 ─────────────────────────────────────────────────────────────────
KIMI_API_KEY=YOUR_KIMI_API_KEY_HERE
KIMI_ENDPOINT=https://bedrock-mantle.us-east-1.api.aws/v1
KIMI_MODEL=moonshotai.kimi-k2.5

# ── Qwen3 Next 80B ───────────────────────────────────────────────────────────
QWEN_API_KEY=YOUR_QWEN_API_KEY_HERE
QWEN_ENDPOINT=https://bedrock-mantle.us-east-1.api.aws/v1
QWEN_MODEL=qwen.qwen3-next-80b-a3b-instruct

# ── MiniMax m2.5 ─────────────────────────────────────────────────────────────
MINIMAX_API_KEY=YOUR_MINIMAX_API_KEY_HERE
MINIMAX_ENDPOINT=https://bedrock-mantle.us-east-1.api.aws/v1
MINIMAX_MODEL=minimax.minimax-m2.5

# ── Database (optional, defaults to SQLite for local dev) ────────────────────
# DATABASE_URL=postgresql://user:password@localhost:5432/resumeai

